# Postgres-Verbindung (Render: "External Database URL" bzw. intern die "Internal Database URL")
DATABASE_URL=postgres://user:password@localhost:5432/cubetimer

# Geheimer Schluessel fuer POST /admin/reports/:id/resolve (Header x-admin-key). Lang und zufaellig waehlen.
ADMIN_KEY=

# Optional: erlaubte Web-Origin fuer CORS (Standard: *)
CLIENT_ORIGIN=

# Optional: Port (Render setzt ihn selbst)
PORT=4000
